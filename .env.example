# ---------------------------------------------------------------------------
# Employment Verification Platform — example environment
# Copy to .env for local dev. In production, secrets come from a vault
# (AWS Secrets Manager / HashiCorp Vault), NEVER from a committed file. (§5)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (application role — NOT a superuser) -------------------------
# The app connects as a limited role so row-level security and the
# append-only audit grants actually constrain it. (§5 Access control)
DATABASE_URL=postgres://hyper_app:hyper_app_pw@localhost:5432/hyper

# Separate URL used only by the migration runner (owner role).
DATABASE_MIGRATION_URL=postgres://hyper:hyper_pw@localhost:5432/hyper

# --- Redis (BullMQ jobs: expiry, notifications, retention purges) ----------
REDIS_URL=redis://localhost:6379

# --- Running the tests ------------------------------------------------------
# The integration suite must NOT share this database. It suspends accounts,
# spends rate-limit budgets and leaves hundreds of rows behind; pointed at a
# development database it has taken out real logins and produced failures that
# were nothing but leftover data.
#
# Create a .env.test beside this file naming its own database and Redis index:
#
#   NODE_ENV=test
#   DATABASE_URL=postgres://hyper_app:hyper_app_pw@localhost:5432/hyper_test
#   DATABASE_MIGRATION_URL=postgres://hyper:hyper_pw@localhost:5432/hyper_test
#   REDIS_URL=redis://localhost:6379/1
#
# Anything .env.test does not mention falls back to .env. `npm test` creates and
# migrates that database itself, and refuses to run unless the database name
# ends with _test.

# --- Object storage (evidence files only — never inlined in the DB) --------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hyper-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Encryption at rest for evidence + identity documents (§5). Local MinIO has no
# KMS, so dev runs with 'none'; the API refuses to boot in production unless
# this is AES256 or aws:kms (set S3_SSE_KMS_KEY_ID with the latter).
S3_SSE=none
# S3_SSE_KMS_KEY_ID=

# --- Auth ------------------------------------------------------------------
# Use long random values in real environments. Access tokens short-lived,
# refresh tokens rotated. MFA required for Admin/SuperAdmin/ReviewBoard. (§2)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Pepper mixed into national_id hashing so a DB leak alone can't rainbow-table
# subject identifiers. Rotate via re-hash migration, never log this value.
SUBJECT_ID_PEPPER=dev-subject-pepper-change-me

# --- Feature flags ---------------------------------------------------------
# Tier B (conduct reports) MUST stay off until the Phase 0 legal review is
# complete. Off by default in EVERY env. (§7)
FEATURE_TIER_B_ENABLED=false

# Team invitations. Off by default: there is no email transport yet, so an
# invitation is a link an administrator copies and sends by some channel of
# their own. Turn it on once that is a deliberate decision for the deployment.
FEATURE_TEAM_INVITES_ENABLED=false

# --- Retention (§5 Retention & expiry) -------------------------------------
# Auto-expiry window applied to approved conduct reports.
REPORT_EXPIRY_YEARS=5

# Right-of-reply response window (days) after a pre-publication notice.
NOTICE_WINDOW_DAYS=14
